{
  "genome": "1",
  "name": "sum-checker",
  "kind": "tool",
  "purpose": "Checks that a claimed sum of two whole numbers is right, and refuses anything else.",
  "lane": {
    "id": "sums",
    "accepts": "a claim that two whole numbers add up to a total",
    "refuses": "anything that is not a claimed sum"
  },
  "interface": {
    "in": "{\"sum\":[a,b],\"claim\":n}",
    "out": "verified, unverified or refused"
  },
  "judge": {
    "what": "a + b equals the claim, exactly",
    "run": "node genome/judge.mjs",
    "cases": {
      "good": {
        "sum": [
          2,
          3
        ],
        "claim": 5
      },
      "bad": {
        "sum": [
          2,
          3
        ],
        "claim": 6
      }
    }
  },
  "boundary": {
    "run": "node genome/lane.mjs",
    "inLane": {
      "sum": [
        40,
        2
      ],
      "claim": 42
    },
    "outOfLane": {
      "question": "What is the weather in Leeds?"
    },
    "escalate": "kar"
  },
  "health": {
    "run": "node genome/health.mjs"
  },
  "tombstone": {
    "apply": "node genome/tombstone.mjs apply",
    "restore": "node genome/tombstone.mjs restore"
  },
  "provenance": {
    "repo": "sjgant80-hub/estate-genome",
    "by": "Kar (worked example)",
    "born": "2026-11-20"
  }
}
